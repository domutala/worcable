# --- Configuration du Serveur ---
# Port d'écoute du service (Défaut: 3000)
PORT=3000

# URL racine du service. Optionnel en dev.
# Si vide, le service utilise généralement http://localhost:PORT
BASE_URL=

# Le token d'accès obtenu via l'API de base
SERVICE_TOKEN=

# L'identifiant unique (UUID) du service créé
SERVICE_ID=

# Code d'identification interne au service
SERVICE_CODE=

# --- Sécurité & API ---
# Clé secrète pour la validation des JSON Web Tokens
# Doit correspondre à la config de sécurité de ton instance
JWT_SECRET=

# Point de terminaison de l'API de base pour la communication inter-services
BASE_API_URL=